quality_summary = pd.DataFrame({
    "NaN": train.isna().sum(),
    "Não aplicável": (train == "Não aplicável").sum(),
    "Sem resposta": (train == "Sem resposta").sum()
})

quality_summary["Total Ausente"] = quality_summary.sum(axis=1)
