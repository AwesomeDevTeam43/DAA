na_counts = train.isna().sum()
not_aplicable = (train == "Não aplicável").sum()
no_answer = (train == "Sem resposta").sum()


missing_summary = pd.DataFrame({ 
    "NaN" : na_counts, 
    "Não aplicável" : not_aplicable, 
    "Sem Resposta" :  no_answer 
})

